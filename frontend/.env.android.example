# The Android app's build settings, read by `pnpm build:android`. Copy this file to .env.android (never
# committed) and fill it in. Only public values belong here: they end up inside the APK.

# Where the app reaches both APIs. https only: the app itself runs at https://localhost inside the phone.
# - https://10.0.2.2 from the Android emulator (the emulator's name for this PC);
# - https://<this PC's address on the Wi-Fi> from a phone (start the stack with BIND_ADDR=0.0.0.0);
# - the real https host for a release build.
VITE_API_BASE=https://10.0.2.2

# Google sign-in's web client ID, the same value as GOOGLE_CLIENT_ID on the server. Empty hides
# "Continue with Google" and "Import from Google Calendar", as on the web.
VITE_GOOGLE_CLIENT_ID=
