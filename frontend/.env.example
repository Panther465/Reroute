# Reroute web app settings, read at build time. Only public values belong here: no secrets.

# Google sign-in client ID (the public one). Leave empty to hide "Continue with Google" and
# "Import from Google Calendar"; the demo account still works when the API has DEMO_LOGIN=true.
VITE_GOOGLE_CLIENT_ID=

# Where the APIs live. Empty means the same origin (behind NGINX, or the dev server's proxy).
VITE_API_BASE=
