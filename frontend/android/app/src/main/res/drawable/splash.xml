<?xml version="1.0" encoding="utf-8"?>
<!-- Only for phones where the splash screen library can't run: the ground colour with the icon, as Chrome
     shows an installed web app. Everywhere else the launch theme's windowSplashScreen* items draw it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/reroute_ground" />
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/reroute_green" />
                </shape>
            </item>
            <item android:drawable="@drawable/ic_launcher_foreground" />
        </layer-list>
    </item>
</layer-list>
