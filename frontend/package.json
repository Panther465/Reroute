{
  "name": "reroute-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../shared/contracts/reroute.openapi.json -o src/api/reroute.d.ts && openapi-typescript ../shared/contracts/raasta.openapi.json -o src/api/raasta.d.ts",
    "build:android": "tsc -b && vite build --mode android && cap sync android",
    "android:open": "cap open android",
    "format": "oxfmt"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@capgo/capacitor-social-login": "^8.7.5",
    "@capgo/capacitor-speech-recognition": "^8.4.4",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/query-sync-storage-persister": "^5.104.4",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-persist-client": "^5.104.4",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.4.4",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  }
}
