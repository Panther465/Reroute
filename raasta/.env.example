# Raasta API settings. Copy to .env for local runs outside Docker. Never commit real values.

# development, test or production. Production refuses the default JWT secret.
APP_ENV=development

# PostgreSQL 16 + PostGIS. Raasta connects as its own role and only touches the `raasta` schema.
DATABASE_URL=postgresql+psycopg://raasta_app:raasta_app@localhost:55432/reroute

# Redis: idempotency keys (24 h) and rate-limit counters. Database 1 keeps Raasta's keys apart.
REDIS_URL=redis://localhost:56379/1

# MongoDB: trimmed GPS rides (collection gps_rides).
MONGO_URL=mongodb://localhost:57017
MONGO_DB=reroute

# The secret the Reroute API signs access tokens with (HS256). Must match the Reroute API.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=reroute
JWT_AUDIENCE=reroute-api

# OSRM, for drawing routes on roads and snapping rides. Leave empty to use straight lines.
OSRM_URL=http://localhost:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_S=4

# Requests larger than this get 413. Recorded rides are the largest bodies.
MAX_BODY_BYTES=1048576

# The city's UTC offset, used for times of day and ISO timestamps.
CITY_UTC_OFFSET=+05:30

# How far a traveller will walk to or from a stand, and how fast.
WALK_RADIUS_M=800
WALK_SPEED_M_PER_MIN=80

# Taps within this many metres of an existing stand reuse it.
STAND_REUSE_RADIUS_M=30

# Rate limits.
RATE_LIMIT_PER_MINUTE=60
CONTRIBUTIONS_PER_DAY=10

# The Reroute API sends this as X-Service-Token on its reads, which then share one bucket of
# SERVICE_RATE_LIMIT_PER_MINUTE. The token can only read. Empty turns it off; production refuses
# a value shorter than 32 characters or starting with dev-only.
RAASTA_SERVICE_TOKEN=
SERVICE_RATE_LIMIT_PER_MINUTE=3000

# Where `python -m app.seed` finds raasta-routes.json.
EXAMPLES_DIR=../examples/bengaluru

# Docker entrypoint switches.
RUN_MIGRATIONS=true
SEED_ON_START=false

LOG_LEVEL=INFO

# CORS stays closed: the app and both APIs are served from one origin behind NGINX.
