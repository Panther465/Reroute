# Reroute's nightly backup (infra/azure/backup.sh); reroute-backup.timer starts it.
[Unit]
Description=Back up Reroute's databases to Azure Storage
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=reroute
ExecStart=/bin/bash /opt/reroute/app/infra/azure/backup.sh
