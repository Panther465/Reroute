# Reroute API settings. Copy to .env for local runs outside Docker; docker-compose.yml sets these too.
# Never commit a real .env. Secrets go only in the server's environment, never in the browser.

# development | test | production. In production DEMO_LOGIN=true is refused and JWT_SECRET must be real.
APP_ENV=development

DATABASE_URL=postgresql+psycopg://reroute_app:reroute_app@localhost:55432/reroute
REDIS_URL=redis://localhost:56379/0
MONGO_URL=mongodb://localhost:57017/reroute

# At least 32 characters. Raasta verifies Reroute's access tokens with the same secret.
JWT_SECRET=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# false only for plain-http local runs without NGINX.
COOKIE_SECURE=true

# Local demo sign-in and the simulated clock. Must be false in production.
DEMO_LOGIN=true
# Load the demo traveller, moderator and Bengaluru trip when the API starts.
SEED_ON_START=true

# Google sign-in (authorization code flow). Leave empty to use the demo login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage

RAASTA_BASE_URL=http://localhost:8001
# sample: examples/<city>/travel-times.json. osrm: live road times from the OSRM services below.
TRAVEL_TIMES_SOURCE=sample
OSRM_CAR_URL=http://localhost:5000
OSRM_FOOT_URL=http://localhost:5001
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Reroute student project (contact via repository)
EXAMPLES_DIR=../examples

# Used to build share links.
PUBLIC_BASE_URL=https://localhost

MAX_BODY_BYTES=65536
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
# How long a check-in waits for the worker before answering 202 with a job ID.
CHECKIN_WAIT_SECONDS=8

# Optional AI helper ("Describe your day"). Off by default; the demo works without it.
AI_HELPER_ENABLED=false
