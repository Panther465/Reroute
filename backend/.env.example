# Reroute API settings. Copy to .env for local runs outside Docker; docker-compose.yml sets these too.
# Never commit a real .env. Secrets go only in the server's environment, never in the browser.

# development | test | production. In production DEMO_LOGIN=true is refused and JWT_SECRET must be real.
APP_ENV=development

DATABASE_URL=postgresql+psycopg://reroute_app:reroute_app@localhost:55432/reroute
REDIS_URL=redis://localhost:56379/0
MONGO_URL=mongodb://localhost:57017/reroute

# At least 32 characters. Raasta verifies Reroute's access tokens with the same secret.
JWT_SECRET=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# false only for plain-http local runs without NGINX.
COOKIE_SECURE=true

# Local demo sign-in and the simulated clock. Must be false in production.
DEMO_LOGIN=true
# Simulated bookings, the wallet and connected partners for every account (nothing real is charged).
SIMULATED_SERVICES=true
# Load the demo traveller, moderator and Bengaluru trip when the API starts.
SEED_ON_START=true

# Google sign-in (authorization code flow). Leave empty to use the demo login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage

RAASTA_BASE_URL=http://localhost:8001
# Sent to Raasta as X-Service-Token (Raasta needs the same value), so the worker gets Raasta's
# service rate limit. Production refuses a value starting "dev-only" or shorter than 32 characters.
RAASTA_SERVICE_TOKEN=dev-only-service-token-change-me-0123456789
# sample: examples/<city>/travel-times.json. osrm: live road times from the OSRM services below.
TRAVEL_TIMES_SOURCE=sample
OSRM_CAR_URL=http://localhost:5000
OSRM_FOOT_URL=http://localhost:5001
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Real roads for the map and the directions (not for planning): FOSSGIS's public OSRM servers, with turn-by-turn
# steps. Their policy: at most one request a second, and a User-Agent naming the app. Empty turns routing off.
ROUTING_CAR_URL=https://routing.openstreetmap.de/routed-car
ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_USER_AGENT=Reroute student project (https://github.com/Panther465/Reroute)
ROUTING_MIN_INTERVAL_MS=1000
ROUTING_DAILY_LIMIT=5000
NOMINATIM_USER_AGENT=Reroute student project (contact via repository)
EXAMPLES_DIR=../examples

# Used to build share links.
PUBLIC_BASE_URL=https://localhost

MAX_BODY_BYTES=65536
RATE_LIMIT_PER_MINUTE=60
# Sign-in (Google and demo), per IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Token refresh and sign-out, per IP.
SESSION_RATE_LIMIT_PER_MINUTE=60
# How long a check-in waits for the worker before answering 202 with a job ID.
CHECKIN_WAIT_SECONDS=8
# From this local time (minutes after midnight; 360 = 06:00) the scheduler plans each trip day on its
# own, for trips the traveller has planned before.
MORNING_PLAN_FROM_MIN=360

# Optional AI helper ("Describe your day"). Off by default (brief, section 11). When on, it calls
# Google Gemini if GEMINI_API_KEY is set, and uses a pattern-based parser when it isn't (or the free
# quota runs out).
AI_HELPER_ENABLED=false
# Free key from https://aistudio.google.com/apikey. Server-side only; never put it in the web app.
GEMINI_API_KEY=
# Flash-Lite answers in 2 to 3 seconds. Full Flash models think first and can take 30 seconds.
GEMINI_MODEL=gemini-3.5-flash-lite
# Roo as an agent (with the AI helper on and a key): it reads the trip with tools and puts every change on one
# card the traveller confirms. Flash-Lite takes 3 to 4 seconds a step. gemini-3.5-flash reasons better, but its
# free tier allows only 20 requests a day (a message takes 3 or 4); when its quota runs out Roo uses GEMINI_MODEL.
ROO_AGENT_MODEL=gemini-3.5-flash-lite
# Messages to Roo's agent per traveller, a minute and a day.
ROO_AGENT_PER_MINUTE=8
ROO_AGENT_PER_DAY=200
# Tests and browser tests only: a JSON file of scripted model answers (tests/fixtures/roo_agent_script.json).
ROO_FAKE_LLM=
