# Reroute API settings. Copy to .env for local runs outside Docker; docker-compose.yml sets these too.
# Never commit a real .env. Secrets go only in the server's environment, never in the browser.

# development | test | production. In production DEMO_LOGIN=true is refused and JWT_SECRET must be real.
APP_ENV=development

DATABASE_URL=postgresql+psycopg://reroute_app:reroute_app@localhost:55432/reroute
REDIS_URL=redis://localhost:56379/0
MONGO_URL=mongodb://localhost:57017/reroute

# At least 32 characters. Raasta verifies Reroute's access tokens with the same secret.
JWT_SECRET=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# false only for plain-http local runs without NGINX.
COOKIE_SECURE=true

# Local demo sign-in and the simulated clock. Must be false in production.
DEMO_LOGIN=true
# Simulated bookings, the wallet and connected partners for every account (nothing real is charged).
SIMULATED_SERVICES=true
# Load the demo traveller, moderator and Bengaluru trip when the API starts.
SEED_ON_START=true

# Google sign-in (authorization code flow). Leave empty to use the demo login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage

# Google Maps Platform (README, "Google Maps"): Google's map, place search and Rico's guide with Google's places.
# The server's key (Map Tiles API, Places API (New), Routes API). Empty keeps OpenStreetMap's.
GOOGLE_MAPS_API_KEY=
# The key the app fetches the map's tiles with (best restricted to the Map Tiles API and your sites); empty uses
# GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_BROWSER_KEY=

# Alerts as push notifications to the Android app (Firebase Cloud Messaging): the path of a Google service
# account key (JSON) with the "Firebase Cloud Messaging API Admin" role. Empty sends no pushes. With Docker
# Compose, set FCM_SERVICE_ACCOUNT (the key's path on this computer) instead: the worker gets it as a secret.
FCM_CREDENTIALS_FILE=
# Push is on in this deployment though this process has no key (Compose sets it from FCM_SERVICE_ACCOUNT on
# every service, so the API can tell the app). Blank or false: only a key here counts.
FCM_PUSH=

RAASTA_BASE_URL=http://localhost:8001
# Sent to Raasta as X-Service-Token (Raasta needs the same value), so the worker gets Raasta's
# service rate limit. Production refuses a value starting "dev-only" or shorter than 32 characters.
RAASTA_SERVICE_TOKEN=dev-only-service-token-change-me-0123456789
# sample: examples/<city>/travel-times.json. osrm: live road times from the OSRM services below.
TRAVEL_TIMES_SOURCE=sample
# Rico's word about busy roads. usual: typical traffic by city, hour and weekday (assumed figures, never live
# data: no traffic service is called). off: no traffic check-ins. A live provider would be another value here.
TRAFFIC_SOURCE=usual
OSRM_CAR_URL=http://localhost:5000
OSRM_FOOT_URL=http://localhost:5001
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Real roads for the map and the directions (not for planning): FOSSGIS's public OSRM servers, with turn-by-turn
# steps. Their policy: at most one request a second, and a User-Agent naming the app. Empty turns routing off.
ROUTING_CAR_URL=https://routing.openstreetmap.de/routed-car
ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_USER_AGENT=Reroute student project (https://github.com/Panther465/Reroute)
ROUTING_MIN_INTERVAL_MS=1000
ROUTING_DAILY_LIMIT=5000
NOMINATIM_USER_AGENT=Reroute student project (contact via repository)
EXAMPLES_DIR=../examples

# Used to build share links.
PUBLIC_BASE_URL=https://localhost
# Origins allowed to call the API from another origin, comma-separated. The Android app runs at
# https://localhost inside the phone; empty keeps CORS closed (the web app shares the API's origin).
CORS_ORIGINS=https://localhost

MAX_BODY_BYTES=65536
RATE_LIMIT_PER_MINUTE=60
# Sign-in (Google and demo), per IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Token refresh and sign-out, per IP.
SESSION_RATE_LIMIT_PER_MINUTE=60
# How long a check-in waits for the worker before answering 202 with a job ID.
CHECKIN_WAIT_SECONDS=8
# From this local time (minutes after midnight; 360 = 06:00) the scheduler plans each trip day on its
# own, for trips the traveller has planned before.
MORNING_PLAN_FROM_MIN=360

# Optional AI helper ("Describe your day"). Off by default (brief, section 11). When on, it calls
# Google Gemini if GEMINI_API_KEY is set, and uses a pattern-based parser when it isn't (or the free
# quota runs out).
AI_HELPER_ENABLED=false
# Free key from https://aistudio.google.com/apikey. Server-side only; never put it in the web app.
GEMINI_API_KEY=
# Flash-Lite answers in 2 to 3 seconds. Full Flash models think first and can take 30 seconds.
GEMINI_MODEL=gemini-3.5-flash-lite
# Roo as an agent (with the AI helper on and a key): it reads the trip with tools and puts every change on one
# card the traveller confirms. Flash-Lite takes 3 to 4 seconds a step. gemini-3.5-flash reasons better, but its
# free tier allows only 20 requests a day (a message takes 3 or 4); when its quota runs out Roo uses GEMINI_MODEL.
ROO_AGENT_MODEL=gemini-3.5-flash-lite
# Messages to Roo's agent per traveller, a minute and a day.
ROO_AGENT_PER_MINUTE=8
ROO_AGENT_PER_DAY=200
# Talking with Rico out loud (the AI helper and a key): Gemini's realtime audio model. Each conversation counts as
# one agent message. ROO_LIVE_VOICE and ROO_LIVE_PITCH (semitones) try another voice for him; left out, his own.
ROO_LIVE_MODEL=gemini-3.8-live
# Tests and browser tests only: a JSON file of scripted model answers (tests/fixtures/roo_agent_script.json).
ROO_FAKE_LLM=
# Rico as a local guide (with the agent): Wikivoyage's city guides and OpenStreetMap's places near a point
# (Overpass), both free and keyless. Guides are kept 7 days, places a day. Empty turns a source off. Web
# look-ups go through Gemini with Google Search, with the key above.
WIKIVOYAGE_URL=https://en.wikivoyage.org/w/api.php
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Rico's voice from Azure AI Speech, Microsoft's official service: a key and its region (such as
# centralindia), from the Speech resource's Keys and Endpoint page in the Azure portal. Its free F0 tier
# gives 0.5 million characters a month. Unset, or when Azure fails, Microsoft Edge's free read-aloud
# service reads the lines. Server-side only; never put the key in the web app.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Email: confirming an address and resetting a forgotten password, through any SMTP server. Docker Compose
# points this at Mailpit, which catches every message locally (http://localhost:8025). For real email, a
# provider's server, for example Brevo (smtp-relay.brevo.com, 587, starttls) or Azure Communication Services
# (smtp.azurecomm.net, 587, starttls); set up SPF, DKIM and DMARC for MAIL_FROM's domain or mail lands in
# spam. Empty SMTP_HOST sends no email: "Forgot your password?" is then not offered.
SMTP_HOST=
SMTP_PORT=587
# starttls (587), ssl (465) or none (Mailpit only).
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Reroute <no-reply@reroute.example>

# Crash and error reports to Sentry (sentry.io or self-hosted): the project's DSN, for the API, the worker and
# the scheduler. Empty sends nothing. Reports never carry names, emails, passwords, tokens, bodies or query
# strings (app/monitoring.py). The share of requests also traced for performance, 0 to 1:
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
