              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/raasta/stands": {
      "get": {
        "tags": [
          "Routes and stands"
        ],
        "summary": "Stands near a point",
        "operationId": "stands_near_v1_raasta_stands_get",
        "parameters": [
          {
            "name": "near",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Centre as \"lng,lat\".",
              "examples": [
                "77.6195,12.9352"
              ],
              "title": "Near"
            },
            "description": "Centre as \"lng,lat\"."
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 10,
              "description": "Metres.",
              "default": 500,
              "title": "Radius"
            },
            "description": "Metres."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_StandNear_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/raasta/cities/{slug}/gtfs.zip": {
      "get": {
        "tags": [
