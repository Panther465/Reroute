                "schema": {
                  "$ref": "#/components/schemas/FareReportOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmationIn": {
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotencykey",
            "examples": [
              "con-7f3a91c2"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idempotencyKey"
        ],
        "title": "ConfirmationIn"
      },
      "ConfirmationOut": {
        "properties": {
          "routeId": {
            "type": "string",
            "title": "Routeid"
          },
          "status": {
            "type": "string",
            "enum": [
              "unverified",
              "verified",
              "stale"
            ],
            "title": "Status"
          },
          "lastConfirmedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastconfirmedat"
          },
          "confirmationsCount": {
            "type": "integer",
            "title": "Confirmationscount"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "routeId",
          "status",
          "lastConfirmedAt",
          "confirmationsCount"
        ],
        "title": "ConfirmationOut"
      },
      "ContributionDecision": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "edit",
              "reject"
            ],
            "title": "Action"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "vehicleType": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "shared_auto",
                  "e_rickshaw",
                  "tempo"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Vehicletype"
          },
          "fareInr": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fareinr"
          },
          "frequencyMin": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 180.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Frequencymin"
          },
          "firstTrip": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "examples": [
                  "21:30"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Firsttrip"
          },
          "lastTrip": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "examples": [
                  "21:30"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Lasttrip"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "ContributionDecision"
      },
      "ContributionIn": {
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotencykey",
            "examples": [
              "con-7f3a91c2"
            ]
          },
          "citySlug": {
            "type": "string",
            "maxLength": 64,
            "minLength": 2,
            "pattern": "^[a-z0-9-]+$",
            "title": "Cityslug",
            "default": "bengaluru"
          },
          "kind": {
            "type": "string",
            "enum": [
              "stands_tapped",
              "gps_ride"
            ],
            "title": "Kind"
          },
          "vehicleType": {
            "type": "string",
            "enum": [
              "shared_auto",
              "e_rickshaw",
              "tempo"
            ],
            "title": "Vehicletype"
          },
          "fareInr": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "Fareinr"
          },
          "frequencyMin": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 1.0,
            "title": "Frequencymin"
          },
          "firstTrip": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Firsttrip",
            "examples": [
              "21:30"
            ]
          },
          "lastTrip": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Lasttrip",
            "examples": [
              "21:30"
            ]
          },
          "stands": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TappedStand"
                },
                "type": "array",
                "maxItems": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Stands"
          },
          "points": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/GpsPoint"
                },
                "type": "array",
                "maxItems": 20000
              },
              {
                "type": "null"
              }
            ],
            "title": "Points"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idempotencyKey",
          "kind",
          "vehicleType",
          "fareInr",
          "frequencyMin",
          "firstTrip",
          "lastTrip"
        ],
        "title": "ContributionIn"
      },
      "ContributionOut": {
        "properties": {
          "contributionId": {
            "type": "string",
            "title": "Contributionid"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "verified",
              "rejected",
              "merged"
            ],
            "title": "Status"
          },
          "routeId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Routeid"
          },
          "contributorId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contributorid"
          },
          "rejectReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rejectreason"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          },
          "decidedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decidedat"
          },
          "payload": {
