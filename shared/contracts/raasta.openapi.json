              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_FareReportOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/raasta/fare-reports/{fare_report_id}": {
      "patch": {
        "tags": [
          "Contributions and moderation"
        ],
        "summary": "Moderator decision on a fare report",
        "operationId": "decide_fare_report_v1_raasta_fare_reports__fare_report_id__patch",
        "parameters": [
          {
            "name": "fare_report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Fare Report Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
