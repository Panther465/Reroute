        ],
        "summary": "Report a fare",
        "operationId": "report_fare_v1_raasta_routes__route_id__fare_reports_post",
        "parameters": [
          {
            "name": "route_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Route Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
