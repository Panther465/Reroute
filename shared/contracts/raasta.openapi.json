{
  "openapi": "3.1.0",
  "info": {
    "title": "Raasta API",
    "description": "\nCrowdsourced shared-auto, e-rickshaw and tempo routes: stands, fares, how often vehicles come\nand when the last one leaves.\n\n- Reads are open data and need no sign-in. Writes need a Reroute access token.\n- Every POST takes an `idempotencyKey` in the body. The same key with the same body returns the\n  first response again; with a different body it returns 409.\n- Errors always look like `{\"error\": {\"code\", \"message\", \"traceId\"}}`.\n- Sample routes are labelled `sample: true`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/raasta/healthz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "The process is up",
        "operationId": "healthz_v1_raasta_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/raasta/readyz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "The database and Redis answer",
        "operationId": "readyz_v1_raasta_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/raasta/routes": {
      "get": {
        "tags": [
          "Routes and stands"
        ],
        "summary": "Shared-auto options for one leg",
        "operationId": "leg_options_v1_raasta_routes_get",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Start as \"lng,lat\".",
              "examples": [
                "77.6195,12.9352"
              ],
              "title": "From"
            },
            "description": "Start as \"lng,lat\"."
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Destination as \"lng,lat\".",
              "examples": [
                "77.5838,12.9255"
              ],
              "title": "To"
            },
            "description": "Destination as \"lng,lat\"."
          },
          {
            "name": "at",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Departure time, ISO 8601. Defaults to now.",
              "title": "At"
            },
            "description": "Departure time, ISO 8601. Defaults to now."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegOptionsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/raasta/routes/{route_id}": {
